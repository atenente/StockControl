<div class="container">
  <div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
      <h1 class="h3 mb-0 text-gray-800"><%= t('global.stock') %></h1>
      <div class="card border-left-primary shadow mt-2">
        <div class="d-flex mt-2">
          <h6 class="p-1"><%= current_user.company_id %></h4>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
          <div class="card-body">
            <div class="row no-gutters align-items-center">
              <div class="col mr-2">
                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                  <%= t('products.products') %>
                </div>
                <div class="h5 mb-0 font-weight-bold text-gray-800">
                  <%= number_with_delimiter(@products_summary[:product_qty_itens]) %>
                </div>
              </div>
              <div class="col-auto">
                <i class="fas fa-calendar fa-2x text-gray-300"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
          <div class="card-body">
            <div class="row no-gutters align-items-center">
              <div class="col mr-2">
                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                  <%= t('global.quantity') %>
                </div>
                <div class="h5 mb-0 font-weight-bold text-gray-800">
                  <%= number_with_delimiter(@products_summary[:product_qty_stock]) %>
                </div>
              </div>
              <div class="col-auto">
                <i class="fas fa-calendar fa-2x text-gray-300"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
          <div class="card-body">
            <div class="row no-gutters align-items-center">
              <div class="col mr-2">
                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                  <%= t('global.value') %>
                </div>
                <div class="h5 mb-0 font-weight-bold text-gray-800">
                  <%= number_to_currency(@products_summary[:product_value]) %>
                </div>
              </div>
              <div class="col-auto">
                <i class="fas fa-calendar fa-2x text-gray-300"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="d-sm-flex align-items-center mb-4">
      <h1 class="h3 mb-0 text-gray-800"><%= t('products.products') %></h1>
    </div>
    <div class="row">
      <div class="card shadow mb-4">
        <div class="card-header">
          <div class="d-flex align-items-center justify-content-between">
            <h6 class="m-0">Ranking <%= t('sales.sales') %></h6>
            <%= form_with url: root_path, method: :get, local: true do |form| %>
              <%= form.date_field :filter_date, value: @filter_date, class: 'btn btn-secondary btn-sm' %>
              <button type="submit" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-search"></i>
              </button>
            <% end %>
          </div>
        </div>
        <div class="row">
          <div class="card-body p-1">
            <div class="row">
              <div class="d-flex justify-content-center">
                <h6><%= t('date.month') %></h6>
              </div>
            </div>
            <div class="row">
              <div class="col mb-1">
                <div class="card border-left-primary p-1">
                  <% if @sales_summary[:top_month_by_invoice].present? %>
                    <div class="d-flex bd-highlight text-nowrap">
                      <div class="p-1 bd-highlight">#</div>
                      <div class="p-1 bd-highlight"><%= t('invoices.invoice') %></div>
                      <div class="p-1 bd-highlight"><%= t('products.product') %></div>
                      <div class="p-1 bd-highlight"><%= t('invoices.description') %></div>
                      <div class="ms-auto p-1 bd-highlight"><%= t('global.value') %></div>
                    </div>
                  <% else %>
                    <div class="d-flex"><%= t('messages.search_empty') %></div>
                  <% end %>
                  <% @sales_summary[:top_month_by_invoice].each_with_index do |sale, i|%>
                    <div class="d-flex bd-highlight text-nowrap">
                      <div class="p-1 bd-highlight"><span class="badge bg-success rounded-pill"><%= i + 1 %></span></div>
                      <div class="p-1 bd-highlight"><%= sale.invoice_id %></div>
                      <div class="p-1 bd-highlight"><%= sale.sku %></div>
                      <div class="p-1 bd-highlight"><%= sale.description %></div>
                      <div class="ms-auto p-1 bd-highlight"><b><%= number_to_currency(sale.amount) %></b></div>
                    </div>
                  <% end %>
                </div>
              </div>
              <div class="col mb-1">
                <div class="card border-left-primary p-1">
                  <% if @sales_summary[:top_month_by_product].present? %>
                    <div class="d-flex bd-highlight text-nowrap">
                      <div class="p-1 bd-highlight">#</div>
                      <div class="p-1 bd-highlight"><%= t('products.product') %></div>
                      <div class="p-1 bd-highlight"><%= t('invoices.description') %></div>
                      <div class="ms-auto p-1 bd-highlight"><%= t('global.value') %></div>
                    </div>
                  <% else %>
                    <div class="d-flex"><%= t('messages.search_empty') %></div>
                  <% end %>
                  <% @sales_summary[:top_month_by_product].each_with_index do |sale, i|%>
                    <div class="d-flex bd-highlight text-nowrap">
                      <div class="p-1 bd-highlight"><span class="badge bg-success rounded-pill"><%= i + 1 %></span></div>
                      <div class="p-1 bd-highlight"><%= sale.sku %></div>
                      <div class="p-1 bd-highlight"><%= sale.description %></div>
                      <div class="ms-auto p-1 bd-highlight"><b><%= number_to_currency(sale.amount) %></b></div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="card-body p-1">
            <div class="row">
              <div class="d-flex justify-content-center">
                <h6><%= t('date.day') %></h6>
              </div>
            </div>
            <div class="row">
              <div class="col mb-1">
                <div class="card border-left-primary p-1">
                  <% if @sales_summary[:top_day_by_invoice].present? %>
                    <div class="d-flex bd-highlight text-nowrap">
                      <div class="p-1 bd-highlight">#</div>
                      <div class="p-1 bd-highlight"><%= t('invoices.invoice') %></div>
                      <div class="p-1 bd-highlight"><%= t('products.product') %></div>
                      <div class="p-1 bd-highlight"><%= t('invoices.description') %></div>
                      <div class="ms-auto p-1 bd-highlight"><%= t('global.value') %></div>
                    </div>
                  <% else %>
                    <div class="d-flex"><%= t('messages.search_empty') %></div>
                  <% end %>
                  <% @sales_summary[:top_day_by_invoice].each_with_index do |sale, i|%>
                    <div class="d-flex bd-highlight text-nowrap">
                      <div class="p-1 bd-highlight"><span class="badge bg-success rounded-pill"><%= i + 1 %></span></div>
                      <div class="p-1 bd-highlight"><%= sale.invoice_id %></div>
                      <div class="p-1 bd-highlight"><%= sale.sku %></div>
                      <div class="p-1 bd-highlight"><%= sale.description %></div>
                      <div class="ms-auto p-1 bd-highlight"><b><%= number_to_currency(sale.amount) %></b></div>
                    </div>
                  <% end %>
                </div>
              </div>
              <div class="col mb-1">
                <div class="card border-left-primary p-1">
                  <% if @sales_summary[:top_day_by_product].present? %>
                    <div class="d-flex bd-highlight text-nowrap">
                      <div class="p-1 bd-highlight">#</div>
                      <div class="p-1 bd-highlight"><%= t('products.product') %></div>
                      <div class="p-1 bd-highlight"><%= t('invoices.description') %></div>
                      <div class="ms-auto p-1 bd-highlight"><%= t('global.value') %></div>
                    </div>
                  <% else %>
                    <div class="d-flex"><%= t('messages.search_empty') %></div>
                  <% end %>
                  <% @sales_summary[:top_day_by_product].each_with_index do |sale, i|%>
                    <div class="d-flex bd-highlight text-nowrap">
                      <div class="p-1 bd-highlight"><span class="badge bg-success rounded-pill"><%= i + 1 %></span></div>
                      <div class="p-1 bd-highlight"><%= sale.sku %></div>
                      <div class="p-1 bd-highlight"><%= sale.description %></div>
                      <div class="ms-auto p-1 bd-highlight"><b><%= number_to_currency(sale.amount) %></b></div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
